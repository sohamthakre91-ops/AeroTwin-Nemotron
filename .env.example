# ============================================================
# AeroTwin-Nemotron: Environment Configuration
# ============================================================
# NOTE: In this Local Core Build phase, no external LLM or API keys
# are required or used. The following placeholders are preserved
# for the subsequent manual integration phase of NVIDIA Nemotron.

# Nebius Token Factory API Key (Future Phase Only)
# NEBIUS_API_KEY=your_nebius_api_key_here

# Nebius Token Factory Base URL (Future Phase Only)
# NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Model Identifier (Future Phase Only)
# NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
